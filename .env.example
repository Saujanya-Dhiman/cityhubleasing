# Set these in Netlify > Site configuration > Environment variables. Never commit real values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CHAT_PROVIDER=openrouter
# OpenRouter: google/gemini-2.5-flash  |  meta-llama/llama-3.3-70b-instruct:free  |  openai/gpt-4o-mini
# Official OpenAI: gpt-4o-mini
OPENAI_CHAT_MODEL=google/gemini-2.0-flash-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set to true to force embedding API calls (OpenRouter embeddings often 404/400; lexical RAG is the default fallback)
OPENAI_EMBEDDINGS_ENABLED=
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}
SITE_URL=https://cityhubleasing.netlify.app
ALLOWED_ORIGIN=https://cityhubleasing.netlify.app
ADMIN_EMAILS=
ADMIN_NOTIFY_WEBHOOK_URL=
WEBHOOK_URL=
